# Copie para .env e preencha com a sua connection string do Neon.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
PORT=3001
# Segredo para assinar os tokens JWT (use um valor aleatório e secreto).
JWT_SECRET=troque-por-um-segredo-aleatorio
# E-mail que vira administrador no boot (padrão: engenharia.promav@gmail.com).
# ADMIN_EMAIL=engenharia.promav@gmail.com
# Contas da equipe que mantém o app, separadas por vírgula: ficam fora da equipe
# dos projetos e dos relatórios. Sem a variável (ou vazia) vale a lista fixa em
# server/index.js (ensureSchema).
# DEV_EMAILS=a@x.com,b@y.com
# Origens liberadas no CORS, separadas por vírgula; ausente/vazio libera todas.
# CORS_ORIGIN=https://promav-web.onrender.com
# Em production o JWT_SECRET é obrigatório: sem ele o backend encerra no boot
# (server/auth.js; no Render o render.yaml já gera com generateValue). Em dev,
# só avisa e cai no segredo fixo de desenvolvimento.
# NODE_ENV=production
# VITE_API_URL não entra aqui: em dev fica vazia (o proxy do Vite responde /api);
# em produção ela vem do .env.production. Preenchida no .env, o Vite a leria e
# o dev passaria a bater direto na API, sem o proxy.

