# Usado pelo `npm run build` do frontend (o Vite embute no bundle).
# No deploy do Render, este valor é sobrescrito pela variável VITE_API_URL do
# Static Site (a variável de ambiente do Render tem prioridade sobre este arquivo).
# Para um build local de produção, troque pela URL pública do backend.
VITE_API_URL=https://promav-api.onrender.com
